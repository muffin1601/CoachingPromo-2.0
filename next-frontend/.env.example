# Production. Next proxies /api and /uploads to the private backend process.
BACKEND_URL=http://127.0.0.1:5001
NEXT_PUBLIC_SITE_URL=https://www.coachingpromo.in
NEXT_PUBLIC_API_PATH=/api
# Empty values keep browser requests on the current storefront origin.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_IMAGE_API_URL=

# Server-only CRM values. Never use NEXT_PUBLIC_ for the API key.
CRM_API_URL=
CRM_API_KEY=

# Local alternatives:
# BACKEND_URL=http://127.0.0.1:5001
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_PATH=/api
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_IMAGE_API_URL=
